# ── Dependencies ────────────────────────────────────────────────────
# The vendored workspaces in app/packages/** are NOT ignored — they are
# the source of truth for @higgsfield/{fnf,fnf-react,quanta,app-landing}
# and must stay in the repo. Only installed dependencies are excluded.
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases

# ── Build output ────────────────────────────────────────────────────
# dist/        → Cloudflare Worker build (dist/client + dist/server)
# dist-static/ → GitHub Pages static build
dist/
dist-static/
dist-ssr/
build/
.output/
.nitro/
.vinxi/
.tanstack/
*.tsbuildinfo

# ── Cloudflare / Wrangler ───────────────────────────────────────────
.wrangler/
.dev.vars
.dev.vars.*

# ── Environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Caches ──────────────────────────────────────────────────────────
.cache/
.temp/
.tmp/
.eslintcache
.vite/

# ── Editors / OS ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
